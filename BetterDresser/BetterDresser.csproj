<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>0.0.0.1</Version>
        <PackageProjectUrl>https://github.com/NeNeppie/BetterDresser</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <Author>NeNeppie</Author>
        <Name>Better Dresser</Name>
        <Punchline>Combines the glamour dresser and armoire into one easy-to-use window</Punchline>
        <Description>Enables a more convenient glamour plate making experience by displaying all available items in one window. 
Filter and sort the items, as you'd normally do with the dresser, along with additional features.</Description>
        <RepoUrl>https://github.com/NeNeppie/BetterDresser</RepoUrl>
        <Tags>Glam, Glamour, Armoire, Dresser</Tags>
        <CategoryTags>Utility, UI</CategoryTags>
    </PropertyGroup>
</Project>
